
#include <stdio.h>

int main()
{
    int A, B;
    int sum, sub, mul;
    float div;

    printf("Enter two integers: ");
    scanf("%d %d", &A, &B);

    sum = A + B;
    sub = A - B;
    mul = A * B;
    div = (float)A / B;

    printf("Addition = %d\n", sum);
    printf("Subtraction = %d\n", sub);
    printf("Multiplication = %d\n", mul);
    printf("Division = %.2f\n", div);

    return 0;
}